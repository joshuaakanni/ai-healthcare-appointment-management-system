      "parameters": {
        "jsCode": "const raw = $json.query ?? $json ?? {};\n\nlet parsed = {};\n\nif (typeof raw === \"string\") {\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    parsed = {};\n  }\n} else {\n  parsed = raw;\n}\n\nfunction toDateOnly(value) {\n  if (!value) return \"\";\n  return String(value).split(\"T\")[0];\n}\n\nreturn [\n  {\n    json: {\n      provider_id: String(parsed.provider_id ?? parsed.providerId ?? \"\").trim(),\n      location_id: String(parsed.location_id ?? parsed.locationId ?? \"\").trim(),\n      date_from: toDateOnly(parsed.date_from ?? parsed.dateFrom),\n      date_to: toDateOnly(parsed.date_to ?? parsed.dateTo),\n      appointment_type: String(parsed.appointment_type ?? parsed.appointmentType ?? \"\").trim()\n    }\n  }\n];"
