      "id": "7aa90347-4ff4-4508-9052-04319ce66ff1",
      "name": "HTTP Request",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.query ?? $json ?? {};\n\nlet parsed = {};\n\nif (typeof raw === \"string\") {\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    const parts = raw.split(\",\").map(v => v.trim()).filter(Boolean);\n    parsed = {\n      fullName: parts[0] || \"\",\n      phoneNumber: parts[1] || \"\",\n      email: parts.find(v => v.includes(\"@\")) || \"\"\n    };\n  }\n} else {\n  parsed = raw;\n}\n\nreturn [\n  {\n    json: {\n      fullName: parsed.fullName || \"\",\n      email: parsed.email || \"\",\n      phone: parsed.phone || parsed.phoneNumber || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        352
      ],
      "id": "2334d88a-fcd1-4287-be2e-bdffcb5deb7f",
      "name": "CODE_normalize_input",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "function uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nreturn [\n  {\n    json: {\n      nonce: uuidv4(),\n      timestamp: Math.floor(Date.now() / 1000)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
