    {
      "parameters": {
        "jsCode": "const raw = $json.query ?? $json ?? {};\n\nlet parsed = {};\n\nif (typeof raw === \"string\") {\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    parsed = {};\n  }\n} else {\n  parsed = raw;\n}\n\nconst fullName = (parsed.fullName || parsed.full_name || \"\").trim();\nconst nameParts = fullName.split(/\\s+/).filter(Boolean);\n\nconst firstName =\n  parsed.first_name ??\n  parsed.firstName ??\n  nameParts[0] ??\n  \"\";\n\nconst lastName =\n  parsed.last_name ??\n  parsed.lastName ??\n  nameParts.slice(1).join(\" \") ??\n  \"\";\n\nreturn [\n  {\n    json: {\n      first_name: String(firstName).trim(),\n      last_name: String(lastName).trim(),\n      email: String(parsed.email ?? \"\").trim().toLowerCase(),\n      phone: String(parsed.phone ?? parsed.phoneNumber ?? \"\").trim(),\n      date_of_birth: String(parsed.date_of_birth ?? parsed.dateOfBirth ?? \"\").trim(),\n      insurance_provider: String(parsed.insurance_provider ?? parsed.insuranceProvider ?? \"\").trim(),\n      member_id: String(parsed.member_id ?? parsed.memberId ?? \"\").trim(),\n      plan_type: String(parsed.plan_type ?? parsed.planType ?? \"\").trim(),\n      language: String(parsed.language ?? \"en\").trim(),\n      preferred_location_id: String(\n        parsed.preferred_location_id ??\n        parsed.preferredLocationId ??\n        parsed.location_id ??\n        parsed.locationId ??\n        \"loc_1\"\n      ).trim()\n    }\n  }\n];"
      },
