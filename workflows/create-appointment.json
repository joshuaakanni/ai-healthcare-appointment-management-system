        "jsCode": "const raw = $json.query ?? $json ?? {};\n\nlet parsed = {};\n\nif (typeof raw === \"string\") {\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    parsed = {};\n  }\n} else {\n  parsed = raw;\n}\n\nreturn [\n  {\n    json: {\n      patient_id: String(parsed.patient_id ?? parsed.patientId ?? \"\").trim(),\n      provider_id: String(parsed.provider_id ?? parsed.providerId ?? \"\").trim(),\n      location_id: String(parsed.location_id ?? parsed.locationId ?? \"\").trim(),\n      appointment_type: String(\n        parsed.appointment_type ?? parsed.appointmentType ?? \"\"\n      ).trim(),\n      start_time: String(parsed.start_time ?? parsed.startTime ?? \"\").trim(),\n      end_time: String(parsed.end_time ?? parsed.endTime ?? \"\").trim(),\n      notes: String(parsed.notes ?? \"\").trim()\n    }\n  }\n];"
